# ==============================================================================
# MAANAK (मानक) — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# API Gateway Configuration
PORT=4000
API_HOST=0.0.0.0
CLIENT_URL=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=maanak_user
POSTGRES_PASSWORD=maanak_pass
POSTGRES_DB=maanak_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://maanak_user:maanak_pass@localhost:5432/maanak_dev?schema=public"

# Authentication & Security
JWT_SECRET=maanak_jwt_super_secret_metrological_token_key_2026_dev
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Standards-as-Code Engine
DEFAULT_RULE_PACK_ID=oiml-r76-2006-v1
RULE_PACKS_DIR=./packages/rules-engine/src/rules

# Storage Configuration
UPLOAD_DIR=./storage/uploads
SIGNED_REPORTS_DIR=./storage/signed_reports
