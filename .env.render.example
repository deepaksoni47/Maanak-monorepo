# ==============================================================================
# MAANAK (मानक) — Render Deployment Environment Variables Template
# ==============================================================================
# Depending on how you deploy on Render, set these environment variables in your
# Render Service Dashboard (Environment tab) or in your Render Blueprint (render.yaml).

# ==============================================================================
# 1. BACKEND SERVICE (maanak-api)
# ==============================================================================

# Node runtime environment
NODE_ENV=production

# Server Port (Render sets this automatically to 10000 on Web Services, or default 4000)
PORT=4000

# PostgreSQL Connection String (Neon, Supabase, or Render PostgreSQL)
# IMPORTANT: Ensure ?sslmode=require is appended for cloud PostgreSQL
DATABASE_URL="postgresql://<user>:<password>@<neon-or-render-db-host>/<dbname>?sslmode=require"

# JWT Authentication Secrets (Must be at least 32 characters long)
# On Render Blueprint, these can be generated automatically with `generateValue: true`
JWT_SECRET=generate_a_secure_random_string_min_32_chars_long
JWT_REFRESH_SECRET=generate_another_secure_random_string_min_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed Cross-Origin Resource Sharing (CORS)
# Set to "*" or your frontend domain: e.g. "https://maanak-web.onrender.com"
CORS_ORIGIN="*"

# Public Verification Base URL (Used in QR codes generated on statutory PDF certificates)
VERIFY_BASE_URL="https://maanak-web.onrender.com/verify"

# Optional Cloudinary Storage for Evidence / Inspection Photos (TASK-077)
# If provided, high-res nameplate & bench test photos upload to Cloudinary CDN
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# ==============================================================================
# 2. FRONTEND SERVICE (maanak-web)
# ==============================================================================

# Node runtime environment
NODE_ENV=production

# Backend Express API URL
# If deploying via render.yaml blueprint, this is automatically linked from maanak-api.
# If deploying manually as a separate Web Service, set it to the URL of your maanak-api:
# Example: https://maanak-api.onrender.com
NEXT_PUBLIC_API_URL="https://maanak-api.onrender.com"

# ==============================================================================
# 3. SINGLE-SERVICE ORCHESTRATED DEPLOYMENT (OPTIONAL)
# ==============================================================================
# If running BOTH backend API and frontend in a single Render Web Service container
# via `node scripts/start-render.mjs`:
#
# PORT=10000                   # Public port assigned by Render
# INTERNAL_API_PORT=4001       # Internal port for Express API
# INTERNAL_API_URL="http://127.0.0.1:4001"
# NEXT_PUBLIC_API_URL="https://your-app-name.onrender.com"
# DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"
# JWT_SECRET=your_jwt_secret
# JWT_REFRESH_SECRET=your_jwt_refresh_secret
# CORS_ORIGIN="*"
# VERIFY_BASE_URL="https://your-app-name.onrender.com/verify"
